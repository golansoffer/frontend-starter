{
  "name": "frontend-repo-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "routes:generate": "node scripts/generate-routes.mjs",
    "typecheck": "pnpm routes:generate && tsc -b",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "ui:add": "shadcn add",
    "lint": "node scripts/check-source-policy.mjs && oxlint --config oxlint.config.ts",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:css": "stylelint --config config/stylelint.config.mjs \"src/**/*.css\" --max-warnings 0",
    "check:deps": "knip",
    "check:architecture": "depcruise src --config config/dependency-cruiser.cjs",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "pnpm test:e2e --ui",
    "test:guards": "node --test scripts/guardrails.test.mjs scripts/security-patch.test.mjs",
    "test:security-patch": "node --test scripts/security-patch.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm check:css && pnpm format:check && pnpm check:architecture && pnpm check:deps && pnpm test:guards && pnpm test:coverage && vite build",
    "check:all": "pnpm check && pnpm test:e2e && pnpm audit --audit-level moderate",
    "prepare": "husky",
    "preinstall": "node scripts/require-pnpm.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-generator": "1.167.40",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.5.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "knip": "6.39.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.3",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/index.css"
  },
  "knip": {
    "stylelint": {
      "config": "config/stylelint.config.mjs"
    },
    "entry": [
      "src/routes/**/*.{ts,tsx}"
    ],
    "project": [
      "src/**/*.{ts,tsx,css}",
      "e2e/**/*.ts",
      "config/**/*.{ts,mjs,cjs}",
      "*.config.ts",
      "scripts/*.mjs"
    ],
    "ignore": [
      "src/components/ui/**"
    ],
    "ignoreExportsUsedInFile": true
  }
}
